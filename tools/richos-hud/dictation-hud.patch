+import CoreAudio
+import XCTest
+@testable import OpenWisprLib
+
+final class AudioRecorderEngineReuseTests: XCTestCase {
+
+    func testEngineIsReusedWhileTheDeviceIsUnchanged() {
+        XCTAssertTrue(AudioRecorder.canReuseEngine(builtFor: 101, wanted: 101))
+    }
+
+    func testEngineIsRebuiltWhenTheInputDeviceChanged() {
+        XCTAssertFalse(AudioRecorder.canReuseEngine(builtFor: 101, wanted: 94))
+    }
+
+    func testEngineBuiltWithoutAnyInputDeviceIsNeverReused() {
+        // The failure this guards: the app starts with the microphone unplugged,
+        // caches an engine that has nothing to record from, and stays silently
+        // broken for the lifetime of the process.
+        XCTAssertFalse(
+            AudioRecorder.canReuseEngine(builtFor: kAudioObjectUnknown, wanted: 101)
+        )
+    }
+
+    func testNoEngineIsBuiltWhileThereIsNoInputDevice() {
+        XCTAssertFalse(AudioRecorder.canReuseEngine(builtFor: 101, wanted: kAudioObjectUnknown))
+        XCTAssertFalse(AudioRecorder.canReuseEngine(builtFor: nil, wanted: kAudioObjectUnknown))
+    }
+
+    func testAbsentEngineIsNeverReusable() {
+        XCTAssertFalse(AudioRecorder.canReuseEngine(builtFor: nil, wanted: 101))
+    }
+}
diff --git a/Tests/OpenWisprTests/DictationHUDModelTests.swift b/Tests/OpenWisprTests/DictationHUDModelTests.swift
new file mode 100644
index 0000000..dcb159b
--- /dev/null
+++ b/Tests/OpenWisprTests/DictationHUDModelTests.swift
@@ -0,0 +1,220 @@
+import XCTest
+@testable import OpenWisprLib
+
+final class DictationHUDModelTests: XCTestCase {
+
+    // MARK: - AudioLevelMeter.rms
+
+    func testRMSOfSilenceIsZero() {
+        XCTAssertEqual(AudioLevelMeter.rms([0, 0, 0, 0]), 0)
+    }
+
+    func testRMSOfEmptyIsZero() {
+        XCTAssertEqual(AudioLevelMeter.rms([]), 0)
+    }
+
+    func testRMSOfConstant() {
+        XCTAssertEqual(AudioLevelMeter.rms([0.5, 0.5, 0.5]), 0.5, accuracy: 1e-6)
+    }
+
+    func testRMSOfSymmetricSignal() {
+        // ±0.5 → RMS 0.5 (sign-independent).
+        XCTAssertEqual(AudioLevelMeter.rms([0.5, -0.5, 0.5, -0.5]), 0.5, accuracy: 1e-6)
+    }
+
+    // MARK: - AudioLevelMeter.normalized (dB window mapping)
+
+    func testNormalizedFloorIsZero() {
+        let meter = AudioLevelMeter()
+        // Amplitude well below the floor (-55 dB ≈ 0.00178) reads as 0.
+        XCTAssertEqual(meter.normalized(rms: 0.0001), 0, accuracy: 1e-6)
+    }
+
+    func testNormalizedCeilingIsOne() {
+        let meter = AudioLevelMeter()
+        // Full-scale amplitude reads as a full meter.
+        XCTAssertEqual(meter.normalized(rms: 1.0), 1, accuracy: 1e-6)
+    }
+
+    func testNormalizedIsMonotonic() {
+        let meter = AudioLevelMeter()
+        let a = meter.normalized(rms: 0.01)
+        let b = meter.normalized(rms: 0.05)
+        let c = meter.normalized(rms: 0.2)
+        XCTAssertLessThan(a, b)
+        XCTAssertLessThan(b, c)
+    }
+
+    func testNormalizedStaysInUnitRange() {
+        let meter = AudioLevelMeter()
+        for rms in stride(from: Float(0), through: 2, by: 0.05) {
+            let v = meter.normalized(rms: rms)
+            XCTAssertGreaterThanOrEqual(v, 0)
+            XCTAssertLessThanOrEqual(v, 1)
+        }
+    }
+
+    // MARK: - AudioLevelMeter.update (attack/decay smoothing)
+
+    func testUpdateRisesTowardTargetButNotInstantly() {
+        var meter = AudioLevelMeter()
+        let first = meter.update(rms: 1.0) // target 1.0, attack 0.6 → 0.6
+        XCTAssertEqual(first, 0.6, accuracy: 1e-5)
+        let second = meter.update(rms: 1.0) // 0.6 + (1-0.6)*0.6 = 0.84
+        XCTAssertEqual(second, 0.84, accuracy: 1e-5)
+        XCTAssertGreaterThan(second, first)
+    }
+
+    func testAttackIsFasterThanDecay() {
+        var rising = AudioLevelMeter()
+        let riseStep = rising.update(rms: 1.0) // from 0 → 0.6
+
+        var falling = AudioLevelMeter()
+        _ = falling.update(rms: 1.0)
+        _ = falling.update(rms: 1.0)
+        _ = falling.update(rms: 1.0)
+        let before = falling.value
+        let after = falling.update(rms: 0.0) // decay 0.18
+        let fallStep = before - after
+        // A rise from 0 moves more than an equivalent fall from near-full.
+        XCTAssertGreaterThan(riseStep, fallStep)
+    }
+
+    func testUpdateSettlesToZeroOnSilence() {
+        var meter = AudioLevelMeter()
+        _ = meter.update(rms: 1.0)
+        for _ in 0..<200 { _ = meter.update(rms: 0.0) }
+        XCTAssertEqual(meter.value, 0, accuracy: 1e-6)
+    }
+
+    func testUpdateConvergesToFullOnSustainedLoud() {
+        var meter = AudioLevelMeter()
+        for _ in 0..<50 { _ = meter.update(rms: 1.0) }
+        XCTAssertEqual(meter.value, 1, accuracy: 1e-3)
+    }
+
+    func testResetClearsValue() {
+        var meter = AudioLevelMeter()
+        _ = meter.update(rms: 1.0)
+        meter.reset()
+        XCTAssertEqual(meter.value, 0)
+    }
+
+    func testDeterministicForSameInputSequence() {
+        func run() -> [Float] {
+            var m = AudioLevelMeter()
+            let seq: [Float] = [0.0, 0.3, 0.8, 0.2, 0.0, 0.5]
+            return seq.map { m.update(rms: $0) }
+        }
+        XCTAssertEqual(run(), run())
+    }
+
+    // MARK: - NoAudioDetector
+
+    func testNoWarningBeforeGracePeriod() {
+        var d = NoAudioDetector()
+        // Silent, but still inside grace window → no warning.
+        XCTAssertFalse(d.isSilent(elapsed: 0.5))
+    }
+
+    func testWarnsWhenSilentPastGrace() {
+        var d = NoAudioDetector()
+        d.observe(level: 0.0)
+        d.observe(level: 0.01) // still below threshold
+        XCTAssertTrue(d.isSilent(elapsed: 2.0))
+    }
+
+    func testNoWarningWhenAudioSeen() {
+        var d = NoAudioDetector()
+        d.observe(level: 0.4) // clearly hearing something
+        XCTAssertFalse(d.isSilent(elapsed: 5.0))
+    }
+
+    func testResetClearsMaxLevel() {
+        var d = NoAudioDetector()
+        d.observe(level: 0.9)
+        d.reset()
+        XCTAssertTrue(d.isSilent(elapsed: 5.0))
+    }
+
+    // MARK: - HUDPresenter reducer
+
+    func testRecordingMapsToRecordingDisplay() {
+        let d = HUDPresenter.display(phase: .recording, meterLevel: 0.5, elapsed: 3, noAudio: false)
+        XCTAssertEqual(d, .recording(level: 0.5, elapsed: 3, noAudioWarning: false))
+    }
+
+    func testRecordingCarriesNoAudioWarning() {
+        let d = HUDPresenter.display(phase: .recording, meterLevel: 0, elapsed: 4, noAudio: true)
+        XCTAssertEqual(d, .recording(level: 0, elapsed: 4, noAudioWarning: true))
+    }
+
+    func testTranscribingMapsToTranscribing() {
+        XCTAssertEqual(
+            HUDPresenter.display(phase: .transcribing, meterLevel: 0, elapsed: 0, noAudio: false),
+            .transcribing
+        )
+    }
+
+    func testIdleMapsToHidden() {
+        XCTAssertEqual(
+            HUDPresenter.display(phase: .idle, meterLevel: 0, elapsed: 0, noAudio: false),
+            .hidden
+        )
+    }
+
+    func testProblemMapsToProblem() {
+        XCTAssertEqual(
+            HUDPresenter.display(phase: .problem("boom"), meterLevel: 0, elapsed: 0, noAudio: false),
+            .problem("boom")
+        )
+    }
+
+    func testWaitingForPermissionMapsToProblem() {
+        XCTAssertEqual(
+            HUDPresenter.display(phase: .waitingForPermission, meterLevel: 0, elapsed: 0, noAudio: false),
+            .problem(HUDPresenter.permissionMessage)
+        )
+    }
+
+    // MARK: - AppDelegate.hudPhase (StatusBarController.State → HUDPhase)
+
+    func testStatePhaseMapping() {
+        XCTAssertEqual(AppDelegate.hudPhase(for: .recording), .recording)
+        XCTAssertEqual(AppDelegate.hudPhase(for: .transcribing), .transcribing)
+        XCTAssertEqual(AppDelegate.hudPhase(for: .idle), .idle)
+        XCTAssertEqual(AppDelegate.hudPhase(for: .downloading), .idle)
+        XCTAssertEqual(AppDelegate.hudPhase(for: .copiedToClipboard), .idle)
+        XCTAssertEqual(AppDelegate.hudPhase(for: .waitingForPermission), .waitingForPermission)
+        XCTAssertEqual(AppDelegate.hudPhase(for: .error("disk full")), .problem("disk full"))
+    }
+
+    // MARK: - HUDFormat.elapsed
+
+    func testElapsedFormatting() {
+        XCTAssertEqual(HUDFormat.elapsed(0), "0:00")
+        XCTAssertEqual(HUDFormat.elapsed(3), "0:03")
+        XCTAssertEqual(HUDFormat.elapsed(9), "0:09")
+        XCTAssertEqual(HUDFormat.elapsed(65), "1:05")
+        XCTAssertEqual(HUDFormat.elapsed(600), "10:00")
+    }
+
+    func testElapsedClampsNegative() {
+        XCTAssertEqual(HUDFormat.elapsed(-5), "0:00")
+    }
+
+    // MARK: - Non-activating panel invariant (load-bearing)
+
+    func testHUDPanelNeverBecomesKeyOrMain() {
+        let panel = DictationHUDPanel(
+            contentRect: NSRect(x: 0, y: 0, width: 244, height: 44),
+            styleMask: [.borderless, .nonactivatingPanel],
+            backing: .buffered,
+            defer: true
+        )
+        // The load-bearing guarantee: showing the HUD must never take focus,
+        // or paste-at-cursor breaks.
+        XCTAssertFalse(panel.canBecomeKey)
+        XCTAssertFalse(panel.canBecomeMain)
+    }
+}
diff --git a/Tests/OpenWisprTests/DictationHUDRenderTests.swift b/Tests/OpenWisprTests/DictationHUDRenderTests.swift
