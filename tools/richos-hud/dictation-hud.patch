index 0000000..32f45dd
--- /dev/null
+++ b/Tests/OpenWisprTests/DictationHUDRenderTests.swift
@@ -0,0 +1,67 @@
+import XCTest
+import AppKit
+@testable import OpenWisprLib
+
+/// Non-intrusive, offscreen render sanity checks: the pill view draws each
+/// state into an in-memory bitmap (no window is ever ordered on screen), so we
+/// verify the AppKit drawing paths execute without crashing and are actually
+/// state-sensitive. Live visual verification is deferred to the design lead + the CEO.
+final class DictationHUDRenderTests: XCTestCase {
+
+    private func render(_ display: HUDDisplay, spinner: CGFloat = 0) -> NSBitmapImageRep? {
+        let size = NSSize(width: 244, height: 44)
+        let view = DictationHUDPillView(frame: NSRect(origin: .zero, size: size))
+        view.spinnerPhase = spinner
+        view.display = display
+        guard let rep = view.bitmapImageRepForCachingDisplay(in: view.bounds) else { return nil }
+        view.cacheDisplay(in: view.bounds, to: rep)
+        return rep
+    }
+
+    private func nonEmpty(_ rep: NSBitmapImageRep?) -> Bool {
+        guard let rep = rep else { return false }
+        // Sample the center; the pill background is drawn there for every visible state.
+        let x = rep.pixelsWide / 2
+        let y = rep.pixelsHigh / 2
+        guard let color = rep.colorAt(x: x, y: y) else { return false }
+        return color.alphaComponent > 0
+    }
+
+    func testRecordingRendersNonEmpty() {
+        XCTAssertTrue(nonEmpty(render(.recording(level: 0.7, elapsed: 3, noAudioWarning: false))))
+    }
+
+    func testTranscribingRendersNonEmpty() {
+        XCTAssertTrue(nonEmpty(render(.transcribing, spinner: 90)))
+    }
+
+    func testProblemRendersNonEmpty() {
+        XCTAssertTrue(nonEmpty(render(.problem("No audio — check mic"))))
+    }
+
+    func testNoAudioWarningRendersNonEmpty() {
+        XCTAssertTrue(nonEmpty(render(.recording(level: 0, elapsed: 4, noAudioWarning: true))))
+    }
+
+    func testDifferentLevelsProduceDifferentPixels() {
+        // The meter must actually reflect the input level (not just recording state).
+        let low = render(.recording(level: 0.05, elapsed: 1, noAudioWarning: false))
+        let high = render(.recording(level: 0.95, elapsed: 1, noAudioWarning: false))
+        XCTAssertNotNil(low)
+        XCTAssertNotNil(high)
+        XCTAssertFalse(pixelsEqual(low!, high!), "Meter should render differently for different levels")
+    }
+
+    func testRecordingAndTranscribingDiffer() {
+        let rec = render(.recording(level: 0.5, elapsed: 1, noAudioWarning: false))
+        let trans = render(.transcribing, spinner: 45)
+        XCTAssertNotNil(rec)
+        XCTAssertNotNil(trans)
+        XCTAssertFalse(pixelsEqual(rec!, trans!))
+    }
+
+    private func pixelsEqual(_ a: NSBitmapImageRep, _ b: NSBitmapImageRep) -> Bool {
+        guard let da = a.tiffRepresentation, let db = b.tiffRepresentation else { return false }
+        return da == db
+    }
+}
