+/// Watches for audio devices being added or removed. AudioDeviceIDs are only
+/// valid while the device is present, so anything holding one has to re-resolve
+/// when this fires.
+class AudioDeviceChangeObserver {
+    private let handler: () -> Void
+    private var isObserving = false
+
+    private static var address = AudioObjectPropertyAddress(
+        mSelector: kAudioHardwarePropertyDevices,
+        mScope: kAudioObjectPropertyScopeGlobal,
+        mElement: kAudioObjectPropertyElementMain
+    )
+
+    /// CoreAudio calls this on its own thread; hop to main so the handler runs
+    /// where the rest of the app's state lives.
+    private static let listener: AudioObjectPropertyListenerProc = { _, _, _, context in
+        guard let context = context else { return noErr }
+        let observer = Unmanaged<AudioDeviceChangeObserver>.fromOpaque(context).takeUnretainedValue()
+        DispatchQueue.main.async { observer.handler() }
+        return noErr
+    }
+
+    init(handler: @escaping () -> Void) {
+        self.handler = handler
+    }
+
+    deinit {
+        stop()
+    }
+
+    func start() {
+        guard !isObserving else { return }
+
+        let status = AudioObjectAddPropertyListener(
+            AudioObjectID(kAudioObjectSystemObject),
+            &AudioDeviceChangeObserver.address,
+            AudioDeviceChangeObserver.listener,
+            Unmanaged.passUnretained(self).toOpaque()
+        )
+        if status != noErr {
+            print("Warning: failed to observe audio device changes (status: \(status))")
+            return
+        }
+        isObserving = true
+    }
+
+    func stop() {
+        guard isObserving else { return }
+        isObserving = false
+
+        AudioObjectRemovePropertyListener(
+            AudioObjectID(kAudioObjectSystemObject),
+            &AudioDeviceChangeObserver.address,
+            AudioDeviceChangeObserver.listener,
+            Unmanaged.passUnretained(self).toOpaque()
+        )
+    }
+}
