+    func testEveryDefaultLocationIsBuiltFromTheRealHomeAndNotALiteralPath() {
+        // Same invariant the two-model patch asserts. Checking the RESOLVED string for a developer's
+        // name would be checking the wrong thing — on that developer's own machine the correct
+        // answer contains it. What has to hold is that a default is a suffix of THIS user's home,
+        // which is only true if it was built from FileManager rather than typed in.
+        let home = FileManager.default.homeDirectoryForCurrentUser.path
+        if let r = LoroCorrection.resolveServicePath(configured: nil) {
+            XCTAssertTrue(r.hasPrefix(home + "/"),
+                          "a default location must be derived from the current user's home, got \(r)")
+        }
+        // And a configured path that does not exist is never silently used.
+        XCTAssertNil(LoroCorrection.resolveServicePath(configured: "/nope/also-nope.js")
+                        .flatMap { $0 == "/nope/also-nope.js" ? $0 : nil })
+    }
