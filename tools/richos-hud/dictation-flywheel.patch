+    // MARK: - the real thing, across the language boundary
+
+    /// The one test in this file that starts another process.
+    ///
+    /// Everything above proves this app behaves when the corrector is absent. This proves it
+    /// behaves when it is PRESENT — that the shared vocabulary really does reach a dictation, and
+    /// that a term the CEO confirmed once is spelled his way on the way to the paste. Nothing is
+    /// mocked: a real `richos-service`, a real entities file, a real subprocess.
+    ///
+    /// SKIPPED, never failed, when RichOS is not checked out beside this app. open-wispr is a
+    /// standalone application and its suite must stay green for someone who has never heard of
+    /// RichOS; a missing optional integration is not a defect in it.
+    func testTheSharedVocabularyReallyDoesReachADictation() throws {
+        guard let service = LoroCorrection.resolveServicePath(configured: nil) else {
+            throw XCTSkip("richos-service is not installed beside this app — correction is optional")
+        }
+        LoroCorrection.servicePath = service
+        guard LoroCorrection.supportsCorrection() else {
+            throw XCTSkip("the installed richos-service has no correct-text — nothing to integrate with")
+        }
+        try FileManager.default.createDirectory(at: tmp, withIntermediateDirectories: true)
+        let entities = tmp.appendingPathComponent("entities.json")
+        // One entry, exactly as `dictation-answer --confirm` writes it after the CEO answers
+        // *Add "Deepgram" to your vocabulary?* — invented, and nobody's speech.
+        try #"""
+        {"schemaVersion": 1, "version": "2026-08-29", "entities": [
+          {"canonical": "Deepgram", "type": "product", "aliases": [], "mangled": ["deep graham"]}
+        ]}
+        """# .write(to: entities, atomically: true, encoding: .utf8)
+        setenv("RICHOS_ENTITIES_FILE", entities.path, 1)
+        defer { unsetenv("RICHOS_ENTITIES_FILE") }
+
+        let heard = "The deep graham contract is signed, send it to Marla Kestrel."
+        let emitted = LoroCorrection.correct(heard)
+        XCTAssertEqual(emitted, "The Deepgram contract is signed, send it to Marla Kestrel.",
+                       "a confirmed correction reaches the very next dictation")
+
+        // And the journal records BOTH sides, which is what makes the next correction possible.
+        let rec = DictationJournal.Record(
+            id: DictationJournal.newID(), at: 1_700_000_000_000, ms: 6400,
+            model: "large-v3-turbo-q5_0", text: heard, emitted: emitted, audio: nil
+        )
+        XCTAssertTrue(rec.corrected)
+        XCTAssertTrue(DictationJournal.append(rec, at: Date(timeIntervalSince1970: 1_700_000_000)))
+        let onDisk = try String(
+            contentsOf: DictationJournal.dayFileURL(Date(timeIntervalSince1970: 1_700_000_000)),
+            encoding: .utf8
+        )
+        XCTAssertTrue(onDisk.contains("deep graham"), "what was heard")
+        XCTAssertTrue(onDisk.contains("Deepgram"), "and what went out")
+    }
+
+    func testAnIncapableServiceIsDETECTEDRatherThanSilentlyDoingNothing() {
+        // `correct()` swallows every failure by design, so an installed-but-too-old service would be
+        // invisible at the paste. The probe is what makes it sayable.
+        try? FileManager.default.createDirectory(at: tmp, withIntermediateDirectories: true)
+        let fake = tmp.appendingPathComponent("old-service.js")
+        FileManager.default.createFile(atPath: fake.path, contents: Data("console.log('usage:\\n  watch')\n".utf8))
+        LoroCorrection.servicePath = fake.path
+        XCTAssertTrue(LoroCorrection.isAvailable(), "it is installed")
+        XCTAssertFalse(LoroCorrection.supportsCorrection(), "and it cannot do the one thing needed")
+        // And — the part that matters — its stdout does NOT reach the CEO's cursor, even though it
+        // exited zero. This exact fake is where the plausibility guard came from.
+        XCTAssertEqual(LoroCorrection.correct("the deep graham contract is signed today"),
+                       "the deep graham contract is signed today")
+    }
+
+    func testACORRECTIONIsAllowedThroughAndAREWRITEIsNot() {
+        // The guard has to let a real correction past: "deep graham" -> "Deepgram" loses a word.
+        XCTAssertTrue(LoroCorrection.isPlausibleCorrectionOf(
+            "The deep graham contract is signed.", "The Deepgram contract is signed."))
+        XCTAssertTrue(LoroCorrection.isPlausibleCorrectionOf("Call Briella at four.", "Call Priya at four."))
+        // And stop anything that is a different sentence.
+        XCTAssertFalse(LoroCorrection.isPlausibleCorrectionOf("The deep graham contract is signed.", "usage: watch"))
+        XCTAssertFalse(LoroCorrection.isPlausibleCorrectionOf("The deep graham contract is signed.", ""))
+        XCTAssertFalse(LoroCorrection.isPlausibleCorrectionOf(
+            "Send it.", "Send it. Send it. Send it. Send it. Send it. Send it."))
+    }
