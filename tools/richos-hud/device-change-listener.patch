new file mode 100644
index 0000000..072f6a1
--- /dev/null
+++ b/Tests/OpenWisprTests/AudioDeviceObserverTests.swift
@@ -0,0 +1,63 @@
+import CoreAudio
+import XCTest
+@testable import OpenWisprLib
+
+final class AudioDeviceObserverTests: XCTestCase {
+
+    /// Adds and then removes an aggregate device, which is a real change to
+    /// `kAudioHardwarePropertyDevices` — the same notification a microphone
+    /// being plugged in or unplugged produces.
+    private func withTemporaryDevice(_ body: () -> Void) throws {
+        let description: [String: Any] = [
+            kAudioAggregateDeviceUIDKey as String: "open-wispr.tests.devices-changed",
+            kAudioAggregateDeviceNameKey as String: "open-wispr tests",
+            kAudioAggregateDeviceSubDeviceListKey as String: [[String: Any]](),
+            kAudioAggregateDeviceIsPrivateKey as String: 1,
+        ]
+        var deviceID: AudioDeviceID = kAudioObjectUnknown
+        let status = AudioHardwareCreateAggregateDevice(description as CFDictionary, &deviceID)
+        try XCTSkipIf(status != noErr, "cannot create a temporary audio device here (status: \(status))")
+        defer { AudioHardwareDestroyAggregateDevice(deviceID) }
+        body()
+    }
+
+    private func settle(_ seconds: TimeInterval) {
+        let settled = expectation(description: "settled")
+        DispatchQueue.main.asyncAfter(deadline: .now() + seconds) { settled.fulfill() }
+        wait(for: [settled], timeout: seconds + 5)
+    }
+
+    func testObserverFiresWhenADeviceAppears() throws {
+        let fired = expectation(description: "devices changed")
+        fired.assertForOverFulfill = false
+        let observer = AudioDeviceChangeObserver { fired.fulfill() }
+        observer.start()
+        defer { observer.stop() }
+
+        try withTemporaryDevice {
+            wait(for: [fired], timeout: 5)
+        }
+    }
+
+    func testStoppedObserverStopsFiring() throws {
+        var calls = 0
+        let observer = AudioDeviceChangeObserver { calls += 1 }
+        observer.start()
+        observer.stop()
+
+        try withTemporaryDevice { settle(1) }
+        XCTAssertEqual(calls, 0, "a removed listener must not keep firing")
+    }
+
+    func testStartIsIdempotentSoTheHandlerRunsOncePerChange() throws {
+        var calls = 0
+        let observer = AudioDeviceChangeObserver { calls += 1 }
+        observer.start()
+        observer.start()
+        defer { observer.stop() }
+
+        try withTemporaryDevice { settle(1) }
+        // One create; the destroy in the teardown lands after the count is read.
+        XCTAssertEqual(calls, 1)
+    }
+}
