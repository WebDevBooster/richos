+    /// A microphone was plugged in or unplugged. Resolution is otherwise only
+    /// done at startup, on a config change and on wake, so without this a device
+    /// that appears or disappears mid-session is never picked up and recording
+    /// silently captures nothing until the app is restarted.
+    func handleAudioDevicesChanged() {
+        guard isReady else { return }
+
+        let action = recordingLifecycle.audioDevicesChanged(isReady: isReady)
+        let newDeviceID = AudioDeviceManager.resolveConfiguredDeviceID(
+            uid: config.audioInputDeviceUID,
+            legacyID: config.audioInputDeviceID
+        )
+        recorder.preferredDeviceID = newDeviceID
+        print("Audio devices changed: input=\(newDeviceID.map(String.init) ?? "system default")")
+
+        // While recording, the new device is picked up by the next start rather
+        // than by tearing down the engine mid-recording.
+        guard action == .prepareRecorder else { return }
+        recorder.reload()
+    }
+
+    private func registerDevicesChangedObserver() {
+        guard deviceChangeObserver == nil else { return }
+
+        let observer = AudioDeviceChangeObserver { [weak self] in
+            self?.handleAudioDevicesChanged()
+        }
+        observer.start()
+        deviceChangeObserver = observer
+    }
+
+    private func unregisterDevicesChangedObserver() {
+        deviceChangeObserver?.stop()
+        deviceChangeObserver = nil
+    }
