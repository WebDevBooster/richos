diff --git a/Sources/OpenWisprLib/DictationModels.swift b/Sources/OpenWisprLib/DictationModels.swift
new file mode 100644
index 0000000..566afed
--- /dev/null
+++ b/Sources/OpenWisprLib/DictationModels.swift
@@ -0,0 +1,166 @@
+import Foundation
+
+// MARK: - Two-model dictation — pure, AppKit-free, unit-tested
+//
+// RichOS ships ONE dictation app carrying TWO whisper models and a user-facing
+// toggle between them:
+//
+//   Accurate (default) — `large-v3-turbo-q5_0`
+//   Fast    (opt-in)   — `small.en`
+//
+// The numbers behind that choice, all measured on the M4 in
+// The dictation-daemon + q5 brief, 2026-08-26:
+// `large-v3-turbo-q5_0` produced byte-identical transcripts to full
+// `large-v3-turbo` on 34 of 36 runs (the two exceptions are a comma inside
+// `$4,200`), at 1.05 GB less on disk, 1.13 GB less resident (0.86 vs 1.99 GB)
+// and 0.20–0.27 s faster cold. Full `large-v3-turbo` is therefore NOT in the
+// dictation path at all. Against `small.en`, the accurate model costs
+// +86.4 MB of disk and ~0.7 s of latency and buys −2.1 WER points pooled
+// (7.7 % → 5.6 %) — small enough that a second "light" build would be silly,
+// large enough that a fast mode is worth a menu item.
+//
+// ## Why the mode is DERIVED, never stored
+//
+// There is deliberately no `dictationMode` field in `Config`. The mode shown in
+// the menu is computed from `Config.modelSize` — the single value that actually
+// reaches `whisper-cli -m`. A stored mode flag is a second source of truth that
+// can silently disagree with the model the app is really running (pick a model
+// from the full Model submenu and a stored flag goes stale instantly). Deriving
+// it means the label can never lie about what a dictation will use.
+
+/// The two dictation modes RichOS exposes. Raw values are stable identifiers.
+public enum DictationMode: String, CaseIterable, Sendable {
+    case accurate
+    case fast
+
+    /// The menu label. Deliberately plain — the CEO picks a behaviour, not a model file.
+    public var title: String {
+        switch self {
+        case .accurate: return "Accurate"
+        case .fast: return "Fast"
+        }
+    }
+
+    /// One line of honest expectation-setting, shown next to the label.
+    public var subtitle: String {
+        switch self {
+        case .accurate: return "best accuracy"
+        case .fast: return "~0.7s quicker"
+        }
+    }
+}
+
+/// Model ids, resolution order, and mode↔model mapping. No I/O beyond `FileManager`
+/// existence checks in the caller — this type only computes candidate paths.
+public enum DictationModels {
+    /// The accurate default. Measured indistinguishable from full `large-v3-turbo`.
+    public static let defaultAccurateModel = "large-v3-turbo-q5_0"
+
+    /// The opt-in fast mode.
+    public static let defaultFastModel = "small.en"
+
+    /// Full `large-v3-turbo` is dropped from the dictation path — it buys nothing
+    /// over `q5_0` and costs 1.05 GB of disk plus 1.13 GB of RAM. It remains the
+    /// default for POST-CALL batch transcription (`tools/richos-service`), which is a
+    /// different workload on different audio and is explicitly out of scope here.
+    public static let retiredDictationModel = "large-v3-turbo"
+
+    /// Which mode a concrete model id corresponds to, or `nil` when the user has
+    /// picked something outside the two-model pair (the full Model submenu still works).
+    public static func mode(
+        for modelSize: String,
+        accurate: String = defaultAccurateModel,
+        fast: String = defaultFastModel
+    ) -> DictationMode? {
+        if modelSize == accurate { return .accurate }
+        if modelSize == fast { return .fast }
+        return nil
+    }
+
+    /// The model id a mode selects.
+    public static func modelSize(
+        for mode: DictationMode,
+        accurate: String = defaultAccurateModel,
+        fast: String = defaultFastModel
+    ) -> String {
+        switch mode {
+        case .accurate: return accurate
+        case .fast: return fast
+        }
+    }
+
+    /// The GGML filename for a model id.
+    public static func fileName(for modelSize: String) -> String {
+        return "ggml-\(modelSize).bin"
+    }
+
+    /// Environment variable holding a `:`-separated list of extra model directories.
+    /// This is the ops-level override: it wins over anything in `config.json` so a
+    /// machine can be repointed without editing the CEO's config.
+    public static let modelDirEnvVar = "OPENWISPR_MODEL_DIR"
+
+    /// Where a model file may live, most-specific first. Every entry is either
+    /// supplied by the caller (env / config) or derived from `home` — there is no
+    /// hardcoded user path anywhere in this list.
+    ///
+    /// - Parameters:
+    ///   - home: the user's home directory (injected so this is testable).
+    ///   - envValue: raw value of `OPENWISPR_MODEL_DIR`, `:`-separated, may be nil.
+    ///   - configuredDir: `config.modelDir`, a single extra directory, may be nil.
+    public static func searchDirectories(
+        home: String,
+        envValue: String? = nil,
+        configuredDir: String? = nil
+    ) -> [String] {
+        var dirs: [String] = []
+
+        for raw in (envValue ?? "").split(separator: ":", omittingEmptySubsequences: true) {
+            let dir = expand(String(raw), home: home)
+            if !dir.isEmpty { dirs.append(dir) }
+        }
+
+        if let configuredDir, !configuredDir.trimmingCharacters(in: .whitespaces).isEmpty {
+            dirs.append(expand(configuredDir, home: home))
+        }
+
+        // open-wispr's own download destination.
+        dirs.append("\(home)/.config/open-wispr/models")
+        // The shared RichOS model directory: `tools/richos-service/lib/config.js`
+        // and `app/crates/richos-voice/src/stt.rs` already resolve here, so one
+        // downloaded .bin serves dictation, the voice loop and call transcription.
+        dirs.append("\(home)/Models/Whisper")
+        // whisper.cpp's own install locations.
+        dirs.append("/opt/homebrew/share/whisper-cpp/models")
+        dirs.append("/usr/local/share/whisper-cpp/models")
+        dirs.append("\(home)/.cache/whisper")
+
+        var seen = Set<String>()
+        return dirs.filter { seen.insert($0).inserted }
+    }
+
+    /// Full candidate paths for a model id, in resolution order. An explicit
+    /// `modelPath` (config `modelPath`) short-circuits everything: if the CEO names
+    /// a file, that file is what runs — no directory scan can override it.
+    public static func candidatePaths(
+        modelSize: String,
+        modelPath: String? = nil,
+        home: String,
+        envValue: String? = nil,
+        configuredDir: String? = nil
+    ) -> [String] {
+        if let modelPath, !modelPath.trimmingCharacters(in: .whitespaces).isEmpty {
+            return [expand(modelPath, home: home)]
+        }
+        let file = fileName(for: modelSize)
+        return searchDirectories(home: home, envValue: envValue, configuredDir: configuredDir)
+            .map { "\($0)/\(file)" }
+    }
+
+    /// Expand a leading `~` against the supplied home. Absolute paths pass through.
+    public static func expand(_ path: String, home: String) -> String {
+        let trimmed = path.trimmingCharacters(in: .whitespaces)
+        if trimmed == "~" { return home }
+        if trimmed.hasPrefix("~/") { return home + String(trimmed.dropFirst(1)) }
+        return trimmed
+    }
+}
