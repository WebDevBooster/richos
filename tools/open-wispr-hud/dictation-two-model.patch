+    /// The two-model dictation toggle: Accurate (`large-v3-turbo-q5_0`, the default)
+    /// and Fast (`small.en`). Top level, not buried in the Model submenu, because it
+    /// is the one model decision the CEO actually makes.
+    ///
+    /// Switching is live — writing the config fires `onConfigChange`, which rebuilds
+    /// the `Transcriber`. Transcription is a fresh `whisper-cli` subprocess per
+    /// utterance, so the very next F13 tap uses the new model. No restart, no reload,
+    /// nothing resident to swap.
+    ///
+    /// The checkmark is derived from `config.dictationMode`, i.e. from the same
+    /// `modelSize` that reaches `whisper-cli -m` — it cannot claim a mode the next
+    /// dictation will not actually use.
+    private func addDictationModeItems(to menu: NSMenu, config: Config) {
+        let header = NSMenuItem(title: "Dictation", action: nil, keyEquivalent: "")
+        header.isEnabled = false
+        menu.addItem(header)
+
+        let current = config.dictationMode
+        for mode in DictationMode.allCases {
+            let model = DictationModels.modelSize(
+                for: mode,
+                accurate: config.effectiveAccurateModel,
+                fast: config.effectiveFastModel
+            )
+            let target = MenuItemTarget { [weak self] in
+                var cfg = Config.load()
+                guard cfg.dictationMode != mode else { return }
+                cfg = cfg.settingDictationMode(mode)
+                try? cfg.save()
+                self?.onConfigChange?(cfg)
+            }
+            menuItemTargets.append(target)
+            let item = NSMenuItem(
+                title: "  \(mode.title) — \(mode.subtitle)",
+                action: #selector(MenuItemTarget.invoke),
+                keyEquivalent: ""
+            )
+            item.target = target
+            item.toolTip = model
+            if current == mode { item.state = .on }
+            menu.addItem(item)
+        }
+
+        if current == nil {
+            let custom = NSMenuItem(title: "  Custom — \(config.modelSize)", action: nil, keyEquivalent: "")
+            custom.isEnabled = false
+            custom.state = .on
+            menu.addItem(custom)
+        }
+    }
+
     func buildMenu() {
         menuItemTargets = []
 
