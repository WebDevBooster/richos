# Rust build output
target/
Cargo.lock

# ACP protocol probe deps (adapter is installed on demand; probe.js + package.json kept as repro)
acp-adapter/node_modules/

# Tauri build / node UI deps
src-tauri/target/
ui/node_modules/
ui/tests/node_modules/

# The SHIPPED frontend, staged from `ui/` by src-tauri/build.rs on every build.
#
# Generated, never authored: `ui/` is the source tree and holds both the product and the
# committed Playwright evidence under `ui/tests/`; this is the subset Tauri embeds into the
# binary. Committing it would put a second, drifting copy of every UI file in the repository
# and double the diff on every UI change.
ui-dist/

# Tauri-generated schemas (regenerated by tauri-build)
src-tauri/gen/
