{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RichOS",
  "version": "0.1.0",
  "identifier": "com.richos.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RichOS",
        "width": 960,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/[email protected]", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Talk to Rich.",
    "longDescription": "RichOS — the executive operating interface. One conversation with Rich."
  }
}
