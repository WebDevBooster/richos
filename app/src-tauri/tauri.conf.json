{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RichOS",
  "version": "0.1.0",
  "identifier": "com.richos.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "RichOS",
        "width": 960,
        "height": 720,
        "resizable": true,
        "visible": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Talk to Rich.",
    "longDescription": "RichOS — the executive operating interface. One conversation with Rich."
  }
}
