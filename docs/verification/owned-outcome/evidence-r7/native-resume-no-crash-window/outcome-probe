  info=os.fstat(fd); passed.append(fd); descriptors.append({'fd':fd,'device':info.st_dev,'inode':info.st_ino})
 except OSError: pass
started=time.time()
child=subprocess.Popen(['/var/folders/mx/w46p9btx1t17wv9tbsq885qw0000gn/T/richos-owned-wake-native-q1h35afd/richos-run-snapshot']+sys.argv[1:],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,pass_fds=tuple(passed))
event={'command':sys.argv[1],'input':json.loads(payload),'lineage':caller,'runner':identities().get(child.pid),'inherited_descriptors':descriptors,'started_at':started,'hook_pid':os.getppid()}
bindings=[]
for state_path in Path('/var/folders/mx/w46p9btx1t17wv9tbsq885qw0000gn/T/richos-owned-wake-native-q1h35afd/state').glob('*.json'):
 state=json.loads(state_path.read_text()); binding=state.get('audit_inference',{})
