 for line in result.stdout.splitlines():
  p=line.strip().split(None,9)
  if len(p)==10: rows[int(p[0])]={'pid':int(p[0]),'ppid':int(p[1]),'pgid':int(p[2]),'status':p[3],'started':' '.join(p[4:9]),'command':p[9]}
