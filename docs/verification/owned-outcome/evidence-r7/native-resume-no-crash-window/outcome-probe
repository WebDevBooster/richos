with Path('/var/folders/mx/w46p9btx1t17wv9tbsq885qw0000gn/T/richos-owned-wake-native-q1h35afd/audits.jsonl').open('a') as log: log.write(json.dumps({**event,'stdout':out,'stderr':err,'exit':child.returncode,'time':time.time()})+'\n')
