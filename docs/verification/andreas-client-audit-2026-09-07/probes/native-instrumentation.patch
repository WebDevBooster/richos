+// Audit-only driver appended to scratch source; clicks the production Send control.
+(async function auditNativeWait() {
+  while (!window.RichBridge || !window.__RICHOS_TIMELINE__ || !document.querySelector('.nav-thread')) await new Promise(r=>setTimeout(r,100));
+  if(window.RichHome?.isOpen()) window.RichHome.hide('audit');
+  const row=document.querySelector('.nav-thread');
+  row.click();
+  while(window.__RICHOS_TIMELINE__().threadId !== row.dataset.threadId) await new Promise(r=>setTimeout(r,100));
+  const readings=[], events=[];
+  const base=performance.now();
+  let last=base;
+  const timer=setInterval(()=>{const now=performance.now();readings.push({t:now-base,gap:now-last,wait:document.querySelector('.turn-wait')?.textContent||'',body:document.getElementById('messages')?.textContent.slice(-350)||''});last=now;},100);
+  let resolveDone;
+  const done=new Promise(r=>resolveDone=r);
+  await window.RichBridge.listen('rich://turn-status',e=>{events.push({t:performance.now()-base,type:e.payload.status}); if(['completed','failed','interrupted'].includes(e.payload.status))resolveDone();});
+  document.getElementById('input').value='AUDIT_SLOW_REPLY';
+  document.getElementById('send').click();
+  await done;
+  await new Promise(r=>setTimeout(r,500));
+  clearInterval(timer);
+  await window.RichBridge.invoke('audit_record',{payload:JSON.stringify({elapsed:performance.now()-base,events,readings})});
+})();
