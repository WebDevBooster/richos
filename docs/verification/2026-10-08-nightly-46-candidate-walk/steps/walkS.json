[
  {"op": "shot", "name": "s-00-boot"},
  {"op": "guest", "command": "P=$(ls -d /Users/admin/testvm/walk-*) && mv \"$P/engine\" \"$P/engine-aside\" && ln -s \"$P/home/Library/Application Support/RichOS/engine\" \"$P/engine\" && ls -ld \"$P/engine\" \"$P/engine-aside\""},
  {"op": "guest", "command": "H=$(ls -d /Users/admin/testvm/walk-*/home) && rm -f \"$H/.claude/.credentials.json\" && echo \"credential file removed\""},
  {"op": "guest", "command": "H=$(ls -d /Users/admin/testvm/walk-*/home) && security delete-generic-password -s 'Claude Code-credentials' \"$H/Library/Keychains/login.keychain-db\" >/dev/null && echo 'plain item removed'", "allow_fail": true},
  {"op": "guest", "command": "H=$(ls -d /Users/admin/testvm/walk-*/home) && h=$(printf '%s' \"$H/.claude\" | shasum -a 256 | cut -c1-8) && security delete-generic-password -s \"Claude Code-credentials-$h\" \"$H/Library/Keychains/login.keychain-db\" >/dev/null && echo 'scoped item removed'", "allow_fail": true},
  {"op": "guest", "command": "H=$(ls -d /Users/admin/testvm/walk-*/home) && HOME=\"$H\" CLAUDE_CONFIG_DIR=\"$H/.claude\" /Users/admin/.local/bin/claude auth status --json | grep -o '\"loggedIn\": *[a-z]*'", "allow_fail": true},
  {"op": "guest", "command": "M=$(ls -d /Users/admin/testvm/walk-*/home/.config/richos/models 2>/dev/null) && ls -l \"$M\" && rm -f \"$M\"/ggml-* && echo 'speech models removed, so the press meets their download'", "allow_fail": true},
  {"op": "relaunch"},
  {"op": "until", "args": ["find", "--title", "Set it up", "--role", "AXButton", "--first"], "contains": "Set it up", "seconds": 120},
  {"op": "ax", "args": ["--focused"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "a bit of setting up", "--contains", "--first"]},
  {"op": "ax", "args": ["find", "--id", "setup-account", "--first"]},
  {"op": "ax", "args": ["find", "--title", "sign up there first and pick the Max/Max 20x tier", "--first", "--json"]},
  {"op": "ax", "args": ["find", "--title", "Account type", "--contains", "--first"], "allow_fail": true},
  {"op": "shot", "name": "s-01-ask-light", "ocr": true},
  {"op": "ax", "args": ["click", "--title", "Set it up", "--role", "AXButton", "--first"]},
  {"op": "wait", "seconds": 3},
  {"op": "guest", "command": "ls -l /Users/admin/testvm/walk-*/home/.config/richos/models/ 2>&1 | tail -n +2"},
  {"op": "shot", "name": "s-02-run-1", "ocr": true},
  {"op": "ax", "args": ["find", "--value", "Setup is done", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "all set", "--contains", "--first"], "allow_fail": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to true'"},
  {"op": "wait", "seconds": 3},
  {"op": "shot", "name": "s-03-run-dark", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to false'"},
  {"op": "wait", "seconds": 2},
  {"op": "guest", "command": "ls -l /Users/admin/testvm/walk-*/home/.config/richos/models/ 2>&1 | tail -n +2"},
  {"op": "shot", "name": "s-04-run-2", "ocr": true},
  {"op": "ax", "args": ["find", "--value", "Setup is done", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "all set", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["click", "--title", "sign up there first and pick the Max/Max 20x tier", "--first"]},
  {"op": "wait", "seconds": 8},
  {"op": "guest", "command": "lsappinfo info -only bundleid \"$(lsappinfo front)\""},
  {"op": "guest", "command": "osascript -e 'tell application \"Safari\" to get URL of front document'", "allow_fail": true},
  {"op": "shot", "name": "s-05-pricing-opened", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application id \"com.richos.app\" to activate' && sleep 2 && lsappinfo info -only bundleid \"$(lsappinfo front)\""},
  {"op": "guest", "command": "ls -l /Users/admin/testvm/walk-*/home/.config/richos/models/ 2>&1 | tail -n +2"},
  {"op": "shot", "name": "s-06-run-3", "ocr": true},
  {"op": "ax", "args": ["find", "--value", "Setup is done", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "all set", "--contains", "--first"], "allow_fail": true},
  {"op": "wait", "seconds": 10},
  {"op": "guest", "command": "ls -l /Users/admin/testvm/walk-*/home/.config/richos/models/ 2>&1 | tail -n +2"},
  {"op": "shot", "name": "s-07-run-4", "ocr": true},
  {"op": "ax", "args": ["find", "--value", "Setup is done", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "all set", "--contains", "--first"], "allow_fail": true},
  {"op": "until", "args": ["find", "--value", "all set", "--contains", "--first"], "contains": "all set", "seconds": 600},
  {"op": "guest", "command": "ls -l /Users/admin/testvm/walk-*/home/.config/richos/models/ 2>&1 | tail -n +2"},
  {"op": "wait", "seconds": 3},
  {"op": "ax", "args": ["find", "--value", "Connect your Anthropic account", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--id", "provider-connect", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--title", "Account type", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "Setup is done", "--contains", "--first"], "allow_fail": true},
  {"op": "tree", "name": "s-08-done-light"},
  {"op": "shot", "name": "s-08-done-light", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to true'"},
  {"op": "wait", "seconds": 4},
  {"op": "shot", "name": "s-09-done-dark", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to false'", "allow_fail": true}
]
