<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. The development bridge (build plan §3.1 L2): no network listener and no
     URL scheme. Commands arrive as an explicit broadcast from `adb shell` (bin/randroid emu …).
     The receiver requires android.permission.DUMP, which the adb shell holds and no ordinary
     app can be granted, so another app on the phone cannot drive it. `randroid check-release`
     proves none of this reaches a release APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".app.debug.DevBridgeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Runs before Application.onCreate: if the CLI has prepared a development world,
             the app opens on it instead of the production ports. -->
        <provider
            android:name=".app.debug.DevBridgeInit"
            android:authorities="${applicationId}.devbridge"
            android:exported="false" />
    </application>
</manifest>
