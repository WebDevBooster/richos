<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the first Compose frame. Not a layout: Compose draws everything. The app
     follows the phone's light/dark setting, so the background is the ground of the phone's theme:
     light #EAE6DD here (tokens.css §15), dark #0C1322 in values-night (§14). Launch never flashes
     the other one. -->
<resources>
    <style name="Theme.RichOS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <color name="launch_ground">#FFEAE6DD</color>
</resources>
