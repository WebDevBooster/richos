<?xml version="1.0" encoding="UTF-8"?>
<!-- RichConnect's launch screen, ported from Android's: the app icon centered on the launch ground
     (native-android themes.xml: windowBackground @color/launch_ground, #EAE6DD light and #0C1322 dark;
     Android 12+ draws @mipmap/ic_launcher centered on it, at a fixed size). The icon is drawn at its own
     size, LaunchShell.iconPoints (134 pt: the share of the screen's width Android's icon takes, 0.3583,
     on the test iPhone), centered on the whole screen as Android centers it. Sized by the image itself
     and positioned by constraints, as the launch art this iPhone rendered before: sized by a multiplier
     on the screen's width, the test iPhone's launch picture came out without it (2026-10-02, recorded),
     though the simulator drew it. LaunchShell.swift draws the same picture as the app's first frame,
     so nothing changes on screen until the conversation itself appears. LaunchIcon is the app icon in
     iOS's icon shape (Tools/launch-icon.py), so the picture continues the icon iOS grows from the Home
     Screen. No text: a launch screen cannot follow the person's text size or language (HIG,
     "Launching"). Never the speckle (the CEO, 2026-09-29). -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LSv-c0-ntl">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="LSs-c0-ene">
            <objects>
                <viewController id="LSv-c0-ntl" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LSr-oo-tvw">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="center" image="LaunchIcon" translatesAutoresizingMaskIntoConstraints="NO" id="LSi-cn-ivw">
                                <rect key="frame" x="129.66666666666666" y="359" width="134" height="134"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LSg-sa-fe0"/>
                        <color key="backgroundColor" name="LaunchGround"/>
                        <constraints>
                            <constraint firstItem="LSi-cn-ivw" firstAttribute="centerX" secondItem="LSr-oo-tvw" secondAttribute="centerX" id="LSk-01-cst"/>
                            <constraint firstItem="LSi-cn-ivw" firstAttribute="centerY" secondItem="LSr-oo-tvw" secondAttribute="centerY" id="LSk-02-cst"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LSf-rs-tr0" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchIcon" width="134" height="134"/>
        <namedColor name="LaunchGround">
            <color red="0.91764705882352937" green="0.90196078431372551" blue="0.8666666666666667" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
