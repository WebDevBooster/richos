#!/usr/bin/env bash
# bin/rios — the one command line for the RichOS native iPhone app.
#
#   bin/rios test [swift test args]   the core's unit tests on this Mac (loop L1, no simulator)
#   bin/rios headless <command>       the real core, headless (loop L1')
#   bin/rios sim <command>            the same commands inside the Debug app on a simulator
#                                     this command created (loop L2)
#   bin/rios perf (--simulator UDID | --reparse DIR) --stamp FILE [perf args]
#                                     cold launch and warm return to the presented, input-ready
#                                     viewport (richos/mobile/perf/perf.py ios; perf/README.md)
#   bin/rios device <command>         a PHYSICAL iPhone; the only way anything touches one. Only the
#                                     Release build goes on it and every test on it tests that build
#                                     (CEO 2026-10-02); nothing uninstalls or wipes an app.
#       build | install               the Release products (built once per committed tree); install
#                                     puts them over the installed app (devicectl), data kept
#       verify <check>                one XCUITest check against the Release app (Tools/physical-device.mjs)
#       perf --device UDID ...        cold launch and warm return on the phone (perf.py ios)
#       run|approval|procs|apps|lock|battery|syslog ...   the walk and its reads (qa/phone-ios.py)
#   bin/rios --help                   every command
#
# Build output never lands in the repository: SwiftPM's scratch directory, DerivedData and the
# generated Xcode project live under the per-checkout cache on /Volumes/E1TB (Part 0 practice).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CORE="$HERE/Core"
VOLUME=/Volumes/E1TB

# A real mount, not an empty directory where the volume should be.
if [ ! -d "$VOLUME" ] || [ "$(stat -f %d "$VOLUME")" = "$(stat -f %d /Volumes)" ]; then
  echo '{"ok":false,"error":"Mount /Volumes/E1TB before running rios"}' >&2
  exit 2
fi

if [ -z "${RICHOS_NATIVE_IOS_CACHE:-}" ]; then
  KEY="$(printf '%s' "$HERE" | shasum -a 256 | cut -c1-10)"
  RICHOS_NATIVE_IOS_CACHE="$VOLUME/caches/richos-native-ios/$KEY"
fi
case "$RICHOS_NATIVE_IOS_CACHE" in
  "$VOLUME"/*) ;;
  *) echo "{\"ok\":false,\"error\":\"RICHOS_NATIVE_IOS_CACHE must be on $VOLUME\"}" >&2; exit 2 ;;
esac
mkdir -p "$RICHOS_NATIVE_IOS_CACHE"
export RICHOS_NATIVE_IOS_CACHE
export RICHOS_NATIVE_IOS_ROOT="$HERE"
# Clang's module cache would otherwise land under the home directory.
export CLANG_MODULE_CACHE_PATH="$RICHOS_NATIVE_IOS_CACHE/module-cache"
SCRATCH="$RICHOS_NATIVE_IOS_CACHE/spm"

if [ "${1:-}" = "perf" ]; then
  shift
  PYTHONDONTWRITEBYTECODE=1 exec python3 "$HERE/../perf/perf.py" ios "$@"
fi

if [ "${1:-}" = "device" ]; then
  shift
  # The tools below refuse a phone unless this verb started them (richos/mobile/physical.py).
  export RICHOS_DEVICE_VERB=rios PYTHONDONTWRITEBYTECODE=1
  case "${1:-}" in
    perf)
      shift
      # Unless a stamp is named: the store's Release bytes for this checkout's committed app tree
      # (`device stamp`, never a build; --expect-commit compares that commit's tree).
      named=0; pick=(); prev=""
      for a in "$@"; do
        [ "$a" = "--stamp" ] && named=1
        case "$prev" in --device|--expect-commit) pick+=("$prev" "$a") ;; esac
        prev="$a"
      done
      if [ "$named" = 0 ]; then
        out="$(node "$HERE/Tools/physical-device.mjs" stamp ${pick[@]+"${pick[@]}"})" || exit 3
        set -- "$@" --stamp "$(printf '%s' "$out" | python3 -c 'import json, sys; print(json.load(sys.stdin)["result"]["stamp"])')"
      fi
      exec python3 "$HERE/../perf/perf.py" ios "$@" ;;
    run|approval|procs|apps|lock|battery|syslog) exec python3 "$HERE/../../app/scripts/qa/phone-ios.py" "$@" ;;
    *) exec node "$HERE/Tools/physical-device.mjs" "$@" ;;
  esac
fi

if [ "${1:-}" = "test" ]; then
  shift
  exec python3 "$HERE/../../engine/scripts/lib/native-work.py" -- swift test --package-path "$CORE" --scratch-path "$SCRATCH" "$@"
fi

# Incremental: a no-op when nothing changed. Its output goes to a log so stdout stays pure JSON.
BUILD_LOG="$RICHOS_NATIVE_IOS_CACHE/cli-build.log"
if ! python3 "$HERE/../../engine/scripts/lib/native-work.py" -- swift build --package-path "$CORE" --scratch-path "$SCRATCH" --product rios-cli >"$BUILD_LOG" 2>&1; then
  tail -40 "$BUILD_LOG" >&2
  echo "{\"ok\":false,\"error\":\"rios-cli did not build; full log: $BUILD_LOG\"}" >&2
  exit 1
fi
exec "$SCRATCH/debug/rios-cli" "$@"
