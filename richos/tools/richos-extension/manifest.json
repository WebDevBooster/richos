{
  "manifest_version": 3,
  "name": "RichOS",
  "version": "0.3.0",
  "description": "RichOS capture. Records call audio locally, health-checks it second by second, and alarms you during the call if anything stops.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "downloads",
    "downloads.ui",
    "notifications",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["modules/call-capture/captions/content-meet.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "modules/call-capture/captions/meet.js",
        "modules/call-capture/captions/adapter.js",
        "modules/call-capture/captions/caption-dedup.js"
      ],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RichOS",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "arm-capture": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Arm RichOS capture on the current tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
