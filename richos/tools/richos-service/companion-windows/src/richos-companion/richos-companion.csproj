<Project Sdk="Microsoft.NET.Sdk">

  <!--
    richos-companion (P3, Windows) — the executable. WASAPI system loopback + process loopback + mic
    (needs the Windows microphone permission for the LEFT channel; loopback needs none) plus the
    headless `ingest`/`doctor` paths that run without any permission. `net8.0-windows` because the
    capture engine is Windows-only COM interop; forced x64 because the process-loopback PROPVARIANT
    field offsets are 64-bit. Zero NuGet dependencies — all WASAPI interop is hand-written P/Invoke —
    so CI restore is trivial and fully self-contained.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>richos-companion</AssemblyName>
    <RootNamespace>RichOSCompanion</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RichOSCompanionCore\RichOSCompanionCore.csproj" />
  </ItemGroup>

</Project>
